<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <AssemblyName>KubDHCP</AssemblyName>
    <RootNamespace>KubDHCP.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\KubDHCP.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <EnableMsixTooling>true</EnableMsixTooling>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <AppxPackage>false</AppxPackage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <Version>1.0.18</Version>
    <Description>Portabler DHCPv4-Server zur Geräteinbetriebnahme</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="ThirdPartyNotices.txt" />
    <EmbeddedResource Include="..\..\assets\KubDHCP.ico" LogicalName="KubDHCP.App.Icon.ico" />
    <EmbeddedResource Include="..\..\assets\KubDHCP.png" LogicalName="KubDHCP.App.Icon.png" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.251221100" />
    <ProjectReference Include="..\KubDHCP.Core\KubDHCP.Core.csproj" />
  </ItemGroup>
</Project>
